{
  "version": "1.0",
  "library": "مكتبة مسعد ماهر للـPrompts",
  "schedule": "daily",
  "mode": "safe",
  "auto_publish": false,
  "min_quality_score": 8,
  "deduplicate_by": ["id", "normalized_prompt"],
  "sources_file": "data/sources.json",
  "prompts_file": "data/prompts.json",
  "log_file": "data/update-log.json",
  "rules": {
    "prefer_official_sources": true,
    "require_prompt_text": true,
    "reject_empty_or_duplicate": true,
    "keep_source_url": true,
    "preserve_existing_prompts": true,
    "review_before_publish": true
  }
}
