{
  "version": "1.7",
  "library": "مكتبة مسعد ماهر للـPrompts",
  "schedule": "daily",
  "mode": "safe_auto",
  "auto_publish": true,
  "min_quality_score": 8,
  "deduplicate_by": ["id", "normalized_prompt"],
  "sources_file": "data/sources.json",
  "prompts_file": "data/prompts.json",
  "inbox_files": [
    "data/inbox/github-prompts.json",
    "data/inbox/lexica-prompts.json",
    "data/inbox/civitai-prompts.json",
    "data/inbox/official-github-prompts.json",
    "data/inbox/official-model-prompts.json",
    "data/inbox/mohamed-ain-prompts.json",
    "data/inbox/nekhly-academy-prompts.json"
  ],
  "log_file": "data/update-log.json",
  "rules": {
    "prefer_official_sources": true,
    "require_prompt_text": true,
    "reject_empty_or_duplicate": true,
    "keep_source_url": true,
    "preserve_existing_prompts": true,
    "auto_publish_only_enabled_connectors": true,
    "minimum_quality_for_auto_publish": 8,
    "review_before_publish": false,
    "preserve_rich_metadata": true,
    "preserve_license": true,
    "never_scrape_review_required_sources": true
  }
}
